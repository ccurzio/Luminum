*.deb
*.txz
*.rpm

# Logs and runtime state (broker, mosquitto, tests)
*.log
log/
*.pid
nohup.out

# SQLite scratch (client config/outqueue/imlogs DBs, test databases)
*.db

# Qwen Code session/worktree scratch
.qwen/

# Editor/tooling
.vscode/
.idea/

# Miscellaneous
*.swp
